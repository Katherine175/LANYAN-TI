# Referencia para Spring Boot; no se carga automáticamente.
# Para Docker Compose usa ../.env basado en ../.env.example.
# README.md explica cómo obtener DB_* desde Compose sin duplicar credenciales.
DB_URL=jdbc:postgresql://localhost:15432/lanyan_ti
DB_USERNAME=lanyan_app
DB_PASSWORD=REEMPLAZAR_CON_UN_SECRETO_LOCAL
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false
AUTH_LOGIN_LIMIT=20
AUTH_LOGIN_WINDOW=5m
